# Configuración de desarrollo local con Redis
# Para probar Horizon en desarrollo
# ===================================

# Cambiar a Redis para desarrollo local (comentar para volver a database)
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Configuración de Redis local
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Configuración de correo para desarrollo (log)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=alfredo@nhoamx.com
MAIL_FROM_NAME="TrainingMS Local"

# Configuración de Horizon para desarrollo
HORIZON_DOMAIN=null
HORIZON_PATH=horizon

# Variables para Vite
VITE_APP_NAME="${APP_NAME}"